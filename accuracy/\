import { Layout, makeScene2D, Rect, Txt } from "@motion-canvas/2d";
import { all, createRef } from "@motion-canvas/core";
import { CatppuccinColors } from "../components/colors";
import { AnimationPresets, AnimationConfig } from "../components/animations";

export default makeScene2D(function* (view) {

  // atkAcc = propAcc + trackExp + tgtDef + bonus
  const atkAcc = createRef<Txt>();
  const propAcc = createRef<Txt>();
  const trackExp = createRef<Txt>();
  const tgtDef = createRef<Txt>();
  const bonus = createRef<Txt>();
  const formulaRef = createRef<Rect>();

  view.add(
    <>
      <Rect
        ref={formulaRef}
        layout
        gap={40}
        justifyContent="center"
        opacity={100}
      >
        <Txt
          ref={atkAcc}
          text="atkAcc"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          text="="
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          ref={propAcc}
          text="propAcc"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          text="+"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          ref={trackExp}
          text="trackExp"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          text="+"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          ref={tgtDef}
          text="tgtDef"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          text="+"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
        <Txt
          ref={bonus}
          text="bonus"
          fill={CatppuccinColors.Text}
          fontWeight={600}
          fontFamily="twilio sans mono"
          fontSize={60}
        />,
      </Rect>
    </>
  );


  yield * AnimationPresets.fadeInUp(formulaRef())
  yield * formulaRef().position.y(-400, 1)

  const totalAccTextRef = createRef<Txt>();
  view.add(
    <Txt
      ref={totalAccTextRef}
      text="Total Accuracy"
      fill={CatppuccinColors.Red}
      fontWeight={600}
      fontFamily="twilio sans mono"
      fontSize={60}
      opacity={0}
    />,
  );
  yield * all(
    atkAcc().fill(CatppuccinColors.Red, 0.5),
    AnimationPresets.fadeInUp(totalAccTextRef())
  )


  yield * all (
    totalAccTextRef().position.y(atkAcc().position.y() - atkAcc().height(), 1),
    totalAccTextRef().position.x(atkAcc().position.x() - atkAcc().width() / 4  , 0.5),
  )
});
